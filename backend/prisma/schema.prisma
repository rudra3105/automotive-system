generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum Role { ADMIN MANAGER STAFF }
enum JobStatus { PENDING IN_PROGRESS COMPLETED }
enum InvoiceType { SALES SERVICE }
enum PaymentStatus { UNPAID PARTIAL PAID }

model Branch { id Int @id @default(autoincrement()) name String code String @unique currency String @default("USD") users User[] customers Customer[] leads Lead[] vehicles Vehicle[] quotations Quotation[] jobCards JobCard[] parts Part[] invoices Invoice[] ledgerEntries LedgerEntry[] settings Setting[] createdAt DateTime @default(now()) }
model User { id Int @id @default(autoincrement()) email String @unique password String fullName String role Role branchId Int branch Branch @relation(fields:[branchId], references:[id]) createdAt DateTime @default(now()) }
model Customer { id Int @id @default(autoincrement()) name String phone String? email String? address String? branchId Int branch Branch @relation(fields:[branchId], references:[id]) interactions Interaction[] sales Sale[] jobCards JobCard[] createdAt DateTime @default(now()) }
model Lead { id Int @id @default(autoincrement()) name String phone String source String? status String @default("new") branchId Int branch Branch @relation(fields:[branchId], references:[id]) createdAt DateTime @default(now()) }
model Interaction { id Int @id @default(autoincrement()) customerId Int customer Customer @relation(fields:[customerId], references:[id]) notes String createdBy Int createdAt DateTime @default(now()) }
model Vehicle { id Int @id @default(autoincrement()) vin String @unique make String model String year Int price Decimal @db.Decimal(12,2) status String @default("available") branchId Int branch Branch @relation(fields:[branchId], references:[id]) quotations Quotation[] sales Sale[] }
model Quotation { id Int @id @default(autoincrement()) customerId Int customer Customer @relation(fields:[customerId], references:[id]) vehicleId Int vehicle Vehicle @relation(fields:[vehicleId], references:[id]) amount Decimal @db.Decimal(12,2) currency String @default("USD") status String @default("draft") branchId Int branch Branch @relation(fields:[branchId], references:[id]) createdAt DateTime @default(now()) }
model Sale { id Int @id @default(autoincrement()) customerId Int customer Customer @relation(fields:[customerId], references:[id]) vehicleId Int vehicle Vehicle @relation(fields:[vehicleId], references:[id]) invoiceId Int? invoice Invoice? @relation(fields:[invoiceId], references:[id]) amount Decimal @db.Decimal(12,2) status String @default("pending") branchId Int createdAt DateTime @default(now()) }
model JobCard { id Int @id @default(autoincrement()) customerId Int customer Customer @relation(fields:[customerId], references:[id]) vehiclePlate String complaint String status JobStatus @default(PENDING) mechanicName String? laborCost Decimal @default(0) @db.Decimal(12,2) branchId Int branch Branch @relation(fields:[branchId], references:[id]) parts JobCardPart[] invoiceId Int? invoice Invoice? @relation(fields:[invoiceId], references:[id]) createdAt DateTime @default(now()) }
model Part { id Int @id @default(autoincrement()) sku String @unique name String unitPrice Decimal @db.Decimal(12,2) stock Int reorderLevel Int @default(5) branchId Int branch Branch @relation(fields:[branchId], references:[id]) jobCardParts JobCardPart[] createdAt DateTime @default(now()) }
model JobCardPart { id Int @id @default(autoincrement()) jobCardId Int jobCard JobCard @relation(fields:[jobCardId], references:[id]) partId Int part Part @relation(fields:[partId], references:[id]) quantity Int unitPrice Decimal @db.Decimal(12,2) }
model Invoice { id Int @id @default(autoincrement()) reference String @unique type InvoiceType customerId Int customer Customer? @relation(fields:[customerId], references:[id]) amount Decimal @db.Decimal(12,2) currency String @default("USD") paidAmount Decimal @default(0) @db.Decimal(12,2) paymentStatus PaymentStatus @default(UNPAID) branchId Int branch Branch @relation(fields:[branchId], references:[id]) jobCards JobCard[] sales Sale[] createdAt DateTime @default(now()) }
model LedgerEntry { id Int @id @default(autoincrement()) date DateTime @default(now()) description String type String amount Decimal @db.Decimal(12,2) currency String @default("USD") branchId Int branch Branch @relation(fields:[branchId], references:[id]) }
model Setting { id Int @id @default(autoincrement()) key String value String branchId Int branch Branch @relation(fields:[branchId], references:[id]) @@unique([key, branchId]) }
